{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-work-plan.py\" \"${CLAUDE_PLUGIN_DATA}\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tell-time-zone.py\" \"${CLAUDE_PLUGIN_DATA}\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tell-reply-images.py\" \"${CLAUDE_PLUGIN_DATA}\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/steward.py\" \"${CLAUDE_PLUGIN_DATA}\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/route-skills.py\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/nudge-work-plan.py\" \"${CLAUDE_PLUGIN_DATA}\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/refresh-work-plan.py\" \"${CLAUDE_PLUGIN_DATA}\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/record-background.py\" \"${CLAUDE_PLUGIN_DATA}\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/route-skills.py\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/record-background.py\" \"${CLAUDE_PLUGIN_DATA}\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-work-plan.py\" \"${CLAUDE_PLUGIN_DATA}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/route-skills.py\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/remind-work-plan.py\" \"${CLAUDE_PLUGIN_DATA}\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/refresh-work-plan.py\" \"${CLAUDE_PLUGIN_DATA}\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/resume-work-plan.py\" \"${CLAUDE_PLUGIN_DATA}\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tell-time-zone.py\" \"${CLAUDE_PLUGIN_DATA}\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tell-reply-images.py\" \"${CLAUDE_PLUGIN_DATA}\""
          }
        ]
      }
    ]
  }
}
